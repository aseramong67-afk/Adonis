<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Adonis</AssemblyName>
    <AssemblyTitle>Adonis</AssemblyTitle>
    <Product>Adonis</Product>
    <Version>1.5.6</Version>
    <InformationalVersion>1.5.6</InformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="auth.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="addons-src\**" />
    <Content Remove="reskins\**" />
    <Content Remove="tools\**" />
  </ItemGroup>

</Project>
